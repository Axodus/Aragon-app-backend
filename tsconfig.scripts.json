{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@package": ["./package.json"],
      "@src/*": ["./src/*"],
      "@config": ["./config/index"],
      "@types": ["./src/types/index"],
      "@artifacts/*": ["./src/artifacts/*"],
      "@helpers/*": ["./src/helpers/*"],
      "@dbModels": ["./src/models/index"],
      "@logger": ["./src/logger/index"],
      "@errors": ["./src/helpers/errors"],
      "@metrics/*": ["./src/metrics/*"],
      "@runners/*": ["./runners/*"],
      "@governance/*": ["./src/governance/*"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@models/*": ["./src/models/*"],
      "@modules/*": ["./src/modules/*"],
      "@services/*": ["./src/services/*"],
      "@state/*": ["./src/state/*"],
      "@api/*": ["./src/services/aragon-api/*"],
      "@indexer/*": ["./src/services/aragon-indexer/*"],
      "@rates/*": ["./src/services/aragon-rates/*"],
      "@admin-api/*": ["./src/services/aragon-admin-api/*"],
      "@tools/*": ["./tools/*"],
      "@test/*": ["./test/*"],
      "@aragonContracts/*": ["./src/services/aragonContracts/*"],
      "@handlers/*": ["./src/handlers/*"],
      "@plugins/*": ["./src/services/aragon-plugins/*"],
      "@transfers": ["./src/modules/transfers/index"]
    }
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "compilerOptions": {
      "module": "commonjs",
      "target": "es2020"
    }
  },
  "include": ["scripts/**/*", "src/**/*", "config/**/*"],
  "exclude": ["node_modules"]
}
