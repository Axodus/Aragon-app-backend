ENVIRONMENT=development
NODE_ENV=production

# Aragon database
#MONGO_DB_URI=YOUR_VALUE_HERE

# Aragon gateway API key used for the IPFS service
#ARAGON_GATEWAY_IPFS_API_KEY=YOUR_VALUE

# Covalent
#COVALENT_API_KEY=YOUR_VALUE

# Dune
#DUNE_API_KEY=YOUR_VALUE

# Api key
#SERVICES_ARAGON_ADMIN_API_API_KEY=YOUR_VALUE_HERE

# 1.country / .country integration (Harmony)
# Used by NameResolver for resolving *.country -> address
# HARMONY_MAINNET_COUNTRY_REGISTRY=0x547942748Cc8840FEc23daFdD01E6457379B446D
# Optional (only if you also run Harmony testnet flows)
# HARMONY_TESTNET_COUNTRY_REGISTRY=YOUR_VALUE_HERE

# Oracle settings
# ---------------------------------------------------
#ORACLE_ADDRESS=0xA55d9ef16Af921b70Fed1421C1D298Ca5A3a18F1      # // Mainnet Band
#BAND_ADDRESS=0x0A87139b65399102f5F9B9B245531CF1A04ec86d        # // Band Adapter